{
  "name": "selara-retreat-showcase",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Original fictional coastal hospitality showcase for Gerbang Studio",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "qa": "npm run check && npm test && npm run build",
    "dev": "python -m http.server 4173 -d public",
    "deploy": "npx wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "4.151.1"
  }
}
